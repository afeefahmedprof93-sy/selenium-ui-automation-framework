<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OrangeHRM Smoke + Functional Suite" parallel="false" thread-count="1">

    <listeners>
        <listener class-name="com.orange.automation.utils.Listeners"/>
    </listeners>

    <test name="OrangeHRM_Functional_Tests" preserve-order="true">
        <classes>
            <!-- Existing Login Tests -->
            <class name="com.orange.automation.testcases.LoginPageTest">
                <methods>
                    <include name="TC_001_LoginWithValidCredentials"/>
                    <include name="TC_002_LoginWithInvalidCredentials"/>
                    <include name="TC_003_LoginWithEmptyFields"/>
                </methods>
            </class>

            <!-- New Functional Test Cases -->
            <class name="com.orange.automation.testcases.FunctionalTest">
                <methods>
                    <!-- PIM Module -->
                    <include name="TC01_VerifyEmployeeSearch"/>
                    <include name="TC02_AddNewEmployee"/>
                    <include name="TC03_EditEmployeeDetails"/>
                    <include name="TC04_DeleteEmployee"/>

                    <!-- Leave Module -->
                    <include name="TC05_ApplyLeave"/>
                    <include name="TC06_VerifyMyLeaveList"/>

                    <!-- My Info & Dashboard -->
                    <include name="TC07_UpdateMyInfo"/>
                    <include name="TC08_VerifyDashboardWidgets"/>

                    <!-- Admin Module -->
                    <include name="TC09_VerifyUserRoleSearch"/>
                    <include name="TC10_AddJobTitle"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>